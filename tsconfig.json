{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist"
  },
  // `scripts/github/**` is the GitHub Action entry point. It is executed from
  // source rather than built, which is exactly why it belongs here: nothing else
  // would ever type-check it. `tsconfig.build.json` restates `include` as
  // `src/**/*.ts`, so widening this one does not put it in the published build.
  "include": ["src/**/*.ts", "scripts/github/**/*.ts", "vitest.config.ts"]
}
