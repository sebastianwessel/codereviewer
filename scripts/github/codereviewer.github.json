{
  "review": {
    "mode": "pr",
    "depth": "balanced"
  },
  "contextSources": {
    "enabled": true,
    "providers": [
      { "type": "inbox", "dir": ".codereviewer/context" },
      { "type": "changed-files", "include": ["docs/**/*.md", "specs/**/*.md"] }
    ],
    "summary": { "mode": "model", "maxBytes": 4000 }
  },
  "intentFulfilment": { "enabled": true },
  "changeImpact": { "enabled": true },
  "reporting": {
    "formats": ["json", "markdown", "sarif"],
    "sarif": { "target": "github" },
    "reviewComments": { "enabled": true, "platform": "github" }
  }
}
