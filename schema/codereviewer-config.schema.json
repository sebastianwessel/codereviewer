{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "review": {
      "default": {},
      "type": "object",
      "properties": {
        "mode": {
          "default": "local",
          "type": "string",
          "enum": [
            "local",
            "ci",
            "pr",
            "full"
          ]
        },
        "depth": {
          "default": "balanced",
          "type": "string",
          "enum": [
            "fast",
            "balanced",
            "thorough"
          ]
        },
        "baseRef": {
          "default": "main",
          "type": "string",
          "minLength": 1
        },
        "headRef": {
          "default": "HEAD",
          "type": "string",
          "minLength": 1
        },
        "maxConcurrentTasks": {
          "default": 4,
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxFiles": {
          "default": 500,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxFileBytes": {
          "default": 500000,
          "type": "integer",
          "minimum": 1,
          "maximum": 5000000
        },
        "contextMaxBytes": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 10000000
        },
        "inlineSeverityThreshold": {
          "default": "high",
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "maxCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "crossFileRetrieval": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "maxToolCallsPerTask": {
              "default": 100,
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "maxBytesPerRead": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 4000000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "openai",
            "openai-compatible",
            "bedrock",
            "azure"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "temperature": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reasoningEffort": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high"
          ]
        },
        "timeoutMs": {
          "default": 120000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "maxRetries": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "retryBackoffMs": {
          "default": 500,
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "retryMaxDelayMs": {
          "default": 30000,
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "required": [
        "id",
        "model"
      ],
      "additionalProperties": false
    },
    "instructions": {
      "default": {},
      "type": "object",
      "properties": {
        "files": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "inline": {
          "default": "",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "directories": {
          "default": [
            ".codereviewer/skills"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowTools": {
          "default": [
            "read",
            "list",
            "grep"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "list",
              "grep"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "paths": {
      "default": {},
      "type": "object",
      "properties": {
        "include": {
          "default": [
            "**/*"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "default": [
            ".git/**",
            "node_modules/**",
            "dist/**",
            "coverage/**",
            ".codereviewer/**",
            "**/package-lock.json",
            "**/yarn.lock",
            "**/pnpm-lock.yaml",
            "**/npm-shrinkwrap.json",
            "**/composer.lock",
            "**/Gemfile.lock",
            "**/poetry.lock",
            "**/Cargo.lock",
            "**/go.sum",
            "**/*.min.js",
            "**/*.min.css",
            "**/*.map",
            "**/*.snap"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifactDir": {
          "default": ".codereviewer/runs",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "path": {
          "default": ".codereviewer/baseline.json",
          "type": "string",
          "minLength": 1
        },
        "failOnNewOnly": {
          "default": true,
          "type": "boolean"
        },
        "includeResolvedInReport": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "qualityGate": {
      "default": {},
      "type": "object",
      "properties": {
        "maxCritical": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxHigh": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxMedium": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failOnProviderError": {
          "default": true,
          "type": "boolean"
        },
        "failOnNewOnly": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "aiReview": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "requireRefutation": {
          "default": true,
          "type": "boolean",
          "const": true
        },
        "deterministicSignalMode": {
          "default": "support",
          "type": "string",
          "enum": [
            "support",
            "disabled"
          ]
        },
        "actionableSeverityThreshold": {
          "default": "medium",
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "maxFilesPerDiscoveryCall": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "promotionPolicy": {
      "default": {},
      "type": "object",
      "properties": {
        "modelWeakOrRefuted": {
          "default": "artifact-only",
          "type": "string",
          "enum": [
            "artifact-only",
            "rejected"
          ]
        }
      },
      "additionalProperties": false
    },
    "contextSources": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "providers": {
          "default": [],
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "inbox"
                  },
                  "dir": {
                    "default": ".codereviewer/context",
                    "type": "string",
                    "minLength": 1
                  },
                  "maxFiles": {
                    "default": 20,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  },
                  "maxFileBytes": {
                    "default": 64000,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "changed-files"
                  },
                  "include": {
                    "default": [
                      "**/*.md"
                    ],
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "maxFiles": {
                    "default": 20,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  },
                  "maxFileBytes": {
                    "default": 64000,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "summary": {
          "default": {},
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "model",
                "digest"
              ]
            },
            "maxBytes": {
              "default": 4000,
              "type": "integer",
              "minimum": 256,
              "maximum": 20000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "providers": {
          "default": [],
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "claims-file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "prior-findings"
                  },
                  "report": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "report"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "maxToolCallsPerClaim": {
          "default": 12,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxBytesPerRead": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 4000000
        },
        "maxMatches": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "changeImpact": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "maxChangedSymbols": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxReferencesPerSymbol": {
          "default": 25,
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxReferenceCandidatesPerSymbol": {
          "default": 500,
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "maxSearchDepth": {
          "default": 12,
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "adjudication": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "maxCalls": {
              "default": 40,
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "intentFulfilment": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "maxObligations": {
          "default": 100,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxIntentBytes": {
          "default": 100000,
          "type": "integer",
          "minimum": 256,
          "maximum": 200000
        },
        "maxChangeLines": {
          "default": 5000,
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      },
      "additionalProperties": false
    },
    "fix": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "minSeverity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        }
      },
      "additionalProperties": false
    },
    "security": {
      "default": {},
      "type": "object",
      "properties": {
        "allowShell": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "allowNetwork": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "allowFilesystemWrite": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "captureContentTelemetry": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "dedicatedPass": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "signals": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "artifacts": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "format": {
                    "default": "sarif",
                    "type": "string",
                    "const": "sarif"
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            },
            "maxArtifactBytes": {
              "default": 4000000,
              "type": "integer",
              "minimum": 1,
              "maximum": 50000000
            },
            "maxAlerts": {
              "default": 40,
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reporting": {
      "default": {},
      "type": "object",
      "properties": {
        "formats": {
          "default": [
            "json",
            "markdown",
            "sarif"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "json",
              "markdown",
              "sarif"
            ]
          }
        },
        "sarif": {
          "default": {},
          "type": "object",
          "properties": {
            "target": {
              "default": "generic",
              "type": "string",
              "enum": [
                "generic",
                "github"
              ]
            },
            "category": {
              "default": "codereviewer",
              "type": "string",
              "minLength": 1
            },
            "maxResults": {
              "default": 5000,
              "type": "integer",
              "minimum": 1,
              "maximum": 25000
            }
          },
          "additionalProperties": false
        },
        "reviewComments": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "platform": {
              "default": "auto",
              "type": "string",
              "enum": [
                "github",
                "gitlab",
                "bitbucket",
                "generic",
                "auto"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "default": {},
      "type": "object",
      "properties": {
        "minJudgeAgreement": {
          "default": 0.9,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "regressionGate": {
          "default": {},
          "type": "object",
          "properties": {
            "profile": {
              "default": "stable",
              "type": "string",
              "enum": [
                "stable",
                "strict"
              ]
            },
            "overrides": {
              "default": {},
              "type": "object",
              "properties": {
                "minParseValidity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minRecall": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minPrecision": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minSeverityWeightedF1": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxFalsePositiveCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maxCommentsPerKloc": {
                  "type": "number",
                  "minimum": 0
                },
                "maxCommentsPerDiffHunk": {
                  "type": "number",
                  "minimum": 0
                },
                "maxIncompleteCoverageRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxContextMutationRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxCostUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "maxDurationMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "minProductRecall": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "failOnProviderError": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "drift": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "failOn": {
          "default": [
            "generated-artifact-drift",
            "security-drift"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "documentation-drift",
              "spec-drift",
              "implementation-drift",
              "generated-artifact-drift",
              "ambiguity",
              "security-drift"
            ]
          }
        },
        "includeDocs": {
          "default": true,
          "type": "boolean"
        },
        "includeSpecs": {
          "default": true,
          "type": "boolean"
        },
        "includeGenerated": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "observability": {
      "default": {},
      "type": "object",
      "properties": {
        "logging": {
          "default": {},
          "type": "object",
          "properties": {
            "level": {
              "default": "silent",
              "type": "string",
              "enum": [
                "trace",
                "debug",
                "info",
                "warn",
                "error",
                "fatal",
                "silent"
              ]
            }
          },
          "additionalProperties": false
        },
        "openTelemetry": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "endpoint": {
              "type": "string",
              "format": "uri"
            },
            "headers": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "serviceName": {
              "default": "codereviewer",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "costs": {
      "default": {},
      "type": "object",
      "properties": {
        "inputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cachedInputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "outputPerMillion": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://codereviewer.local/schemas/config.schema.json",
  "title": "CodeReviewerConfig"
}
