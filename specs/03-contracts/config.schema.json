{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "review": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "local",
          "type": "string",
          "enum": [
            "local",
            "ci",
            "pr",
            "full"
          ]
        },
        "depth": {
          "default": "balanced",
          "type": "string",
          "enum": [
            "fast",
            "balanced",
            "thorough"
          ]
        },
        "baseRef": {
          "default": "main",
          "type": "string",
          "minLength": 1
        },
        "headRef": {
          "default": "HEAD",
          "type": "string",
          "minLength": 1
        },
        "maxConcurrentTasks": {
          "default": 4,
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxFiles": {
          "default": 500,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxFileBytes": {
          "default": 500000,
          "type": "integer",
          "minimum": 1,
          "maximum": 5000000
        },
        "contextMaxBytes": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 10000000
        },
        "inlineSeverityThreshold": {
          "default": "high",
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "maxCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "crossFileRetrieval": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "maxToolCallsPerTask": {
              "default": 100,
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "maxBytesPerRead": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 4000000
            }
          },
          "required": [
            "enabled",
            "maxToolCallsPerTask"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mode",
        "depth",
        "baseRef",
        "headRef",
        "maxConcurrentTasks",
        "maxFiles",
        "maxFileBytes",
        "inlineSeverityThreshold",
        "crossFileRetrieval"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "openai",
            "openai-compatible",
            "bedrock",
            "azure"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "temperature": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reasoningEffort": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high"
          ]
        },
        "timeoutMs": {
          "default": 120000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "maxRetries": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "retryBackoffMs": {
          "default": 500,
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "retryMaxDelayMs": {
          "default": 30000,
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "required": [
        "id",
        "model",
        "temperature",
        "timeoutMs",
        "maxRetries",
        "retryBackoffMs",
        "retryMaxDelayMs"
      ],
      "additionalProperties": false
    },
    "instructions": {
      "type": "object",
      "properties": {
        "files": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inline": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "files",
        "inline"
      ],
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "directories": {
          "default": [
            ".codereviewer/skills"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowTools": {
          "default": [
            "read",
            "list",
            "grep"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "list",
              "grep"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "directories",
        "allowTools"
      ],
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "properties": {
        "include": {
          "default": [
            "**/*"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "default": [
            ".git/**",
            "node_modules/**",
            "dist/**",
            "coverage/**",
            ".codereviewer/**",
            "**/package-lock.json",
            "**/yarn.lock",
            "**/pnpm-lock.yaml",
            "**/npm-shrinkwrap.json",
            "**/composer.lock",
            "**/Gemfile.lock",
            "**/poetry.lock",
            "**/Cargo.lock",
            "**/go.sum",
            "**/*.min.js",
            "**/*.min.css",
            "**/*.map",
            "**/*.snap"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifactDir": {
          "default": ".codereviewer/runs",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "include",
        "exclude",
        "artifactDir"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "path": {
          "default": ".codereviewer/baseline.json",
          "type": "string",
          "minLength": 1
        },
        "failOnNewOnly": {
          "default": true,
          "type": "boolean"
        },
        "includeResolvedInReport": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "path",
        "failOnNewOnly",
        "includeResolvedInReport"
      ],
      "additionalProperties": false
    },
    "qualityGate": {
      "type": "object",
      "properties": {
        "maxCritical": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxHigh": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxMedium": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failOnProviderError": {
          "default": true,
          "type": "boolean"
        },
        "failOnNewOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "maxCritical",
        "maxHigh",
        "failOnProviderError"
      ],
      "additionalProperties": false
    },
    "aiReview": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "requireRefutation": {
          "default": true,
          "type": "boolean",
          "const": true
        },
        "deterministicSignalMode": {
          "default": "support",
          "type": "string",
          "enum": [
            "support",
            "disabled"
          ]
        },
        "actionableSeverityThreshold": {
          "default": "medium",
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "maxFilesPerDiscoveryCall": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "requireRefutation",
        "deterministicSignalMode",
        "actionableSeverityThreshold",
        "maxFilesPerDiscoveryCall"
      ],
      "additionalProperties": false
    },
    "promotionPolicy": {
      "type": "object",
      "properties": {
        "modelWeakOrRefuted": {
          "default": "artifact-only",
          "type": "string",
          "enum": [
            "artifact-only",
            "rejected"
          ]
        }
      },
      "required": [
        "modelWeakOrRefuted"
      ],
      "additionalProperties": false
    },
    "contextSources": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "providers": {
          "default": [],
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "inbox"
                  },
                  "dir": {
                    "default": ".codereviewer/context",
                    "type": "string",
                    "minLength": 1
                  },
                  "maxFiles": {
                    "default": 20,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  },
                  "maxFileBytes": {
                    "default": 64000,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "type",
                  "dir",
                  "maxFiles",
                  "maxFileBytes"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "changed-files"
                  },
                  "include": {
                    "default": [
                      "**/*.md"
                    ],
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "maxFiles": {
                    "default": 20,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  },
                  "maxFileBytes": {
                    "default": 64000,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "type",
                  "include",
                  "maxFiles",
                  "maxFileBytes"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "model",
                "digest"
              ]
            },
            "maxBytes": {
              "default": 4000,
              "type": "integer",
              "minimum": 256,
              "maximum": 20000
            }
          },
          "required": [
            "maxBytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "providers",
        "summary"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "providers": {
          "default": [],
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "claims-file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "prior-findings"
                  },
                  "report": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "report"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "maxToolCallsPerClaim": {
          "default": 12,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxBytesPerRead": {
          "default": 20000,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxMatches": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "providers",
        "maxToolCallsPerClaim",
        "maxBytesPerRead",
        "maxMatches"
      ],
      "additionalProperties": false
    },
    "changeImpact": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "maxChangedSymbols": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxReferencesPerSymbol": {
          "default": 25,
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxSearchDepth": {
          "default": 12,
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      },
      "required": [
        "enabled",
        "maxChangedSymbols",
        "maxReferencesPerSymbol",
        "maxSearchDepth"
      ],
      "additionalProperties": false
    },
    "intentFulfilment": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "maxObligations": {
          "default": 100,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxIntentBytes": {
          "default": 100000,
          "type": "integer",
          "minimum": 256,
          "maximum": 200000
        },
        "maxChangeLines": {
          "default": 5000,
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      },
      "required": [
        "enabled",
        "maxObligations",
        "maxIntentBytes",
        "maxChangeLines"
      ],
      "additionalProperties": false
    },
    "invariantConformance": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "maxChangedDeclarations": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxPeersPerDeclaration": {
          "default": 60,
          "type": "integer",
          "minimum": 3,
          "maximum": 500
        },
        "maxPeerFiles": {
          "default": 300,
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "maxDivergences": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxPreExistingDivergences": {
          "default": 25,
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "adjudication": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "maxAdjudications": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          "required": [
            "enabled",
            "maxAdjudications"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "maxChangedDeclarations",
        "maxPeersPerDeclaration",
        "maxPeerFiles",
        "maxDivergences",
        "maxPreExistingDivergences",
        "adjudication"
      ],
      "additionalProperties": false
    },
    "fix": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "minSeverity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "allowShell": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "allowNetwork": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "allowFilesystemWrite": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "captureContentTelemetry": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "dedicatedPass": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "allowShell",
        "allowNetwork",
        "allowFilesystemWrite",
        "captureContentTelemetry",
        "dedicatedPass"
      ],
      "additionalProperties": false
    },
    "reporting": {
      "type": "object",
      "properties": {
        "formats": {
          "default": [
            "json",
            "markdown",
            "sarif"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "json",
              "markdown",
              "sarif"
            ]
          }
        },
        "sarif": {
          "type": "object",
          "properties": {
            "target": {
              "default": "generic",
              "type": "string",
              "enum": [
                "generic",
                "github"
              ]
            },
            "category": {
              "default": "codereviewer",
              "type": "string",
              "minLength": 1
            },
            "maxResults": {
              "default": 5000,
              "type": "integer",
              "minimum": 1,
              "maximum": 25000
            }
          },
          "required": [
            "target",
            "category",
            "maxResults"
          ],
          "additionalProperties": false
        },
        "reviewComments": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "platform": {
              "default": "auto",
              "type": "string",
              "enum": [
                "github",
                "gitlab",
                "bitbucket",
                "generic",
                "auto"
              ]
            }
          },
          "required": [
            "enabled",
            "platform"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formats",
        "sarif",
        "reviewComments"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "minJudgeAgreement": {
          "default": 0.9,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "regressionGate": {
          "type": "object",
          "properties": {
            "profile": {
              "default": "stable",
              "type": "string",
              "enum": [
                "stable",
                "strict"
              ]
            },
            "overrides": {
              "type": "object",
              "properties": {
                "minParseValidity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minRecall": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minPrecision": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minSeverityWeightedF1": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxFalsePositiveCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maxCommentsPerKloc": {
                  "type": "number",
                  "minimum": 0
                },
                "maxCommentsPerDiffHunk": {
                  "type": "number",
                  "minimum": 0
                },
                "maxIncompleteCoverageRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxContextMutationRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxCostUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "maxDurationMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "minProductRecall": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "failOnProviderError": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "profile",
            "overrides"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "minJudgeAgreement",
        "regressionGate"
      ],
      "additionalProperties": false
    },
    "drift": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "failOn": {
          "default": [
            "generated-artifact-drift",
            "security-drift"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "documentation-drift",
              "spec-drift",
              "implementation-drift",
              "generated-artifact-drift",
              "ambiguity",
              "security-drift"
            ]
          }
        },
        "includeDocs": {
          "default": true,
          "type": "boolean"
        },
        "includeSpecs": {
          "default": true,
          "type": "boolean"
        },
        "includeGenerated": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "failOn",
        "includeDocs",
        "includeSpecs",
        "includeGenerated"
      ],
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "logging": {
          "type": "object",
          "properties": {
            "level": {
              "default": "silent",
              "type": "string",
              "enum": [
                "trace",
                "debug",
                "info",
                "warn",
                "error",
                "fatal",
                "silent"
              ]
            }
          },
          "required": [
            "level"
          ],
          "additionalProperties": false
        },
        "openTelemetry": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "endpoint": {
              "type": "string",
              "format": "uri"
            },
            "headers": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "serviceName": {
              "default": "codereviewer",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "enabled",
            "headers",
            "serviceName"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "logging",
        "openTelemetry"
      ],
      "additionalProperties": false
    },
    "costs": {
      "type": "object",
      "properties": {
        "inputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cachedInputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "outputPerMillion": {
